<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Button?>

<VBox spacing="10.0" prefWidth="220.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="but.info.sae2_12.ui.controllers.IAController"
      style="-fx-padding: 12; -fx-border-color: #cccccc; -fx-border-width: 1; -fx-background-color: #fafafa;"
      VBox.vgrow="ALWAYS" prefHeight="Infinity">

    <Label text="Paramètres de l'IA"
           style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #333333;"/>

    <Separator/>

    <Label text="Score victoire :"
           style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
    <TextField fx:id="winScoreField" onAction="#onWinScoreChanged" maxWidth="Infinity"/>

    <Label text="Poids anneau retiré :"
           style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
    <TextField fx:id="ringRemovedWeightField" onAction="#onRingRemovedWeightChanged" maxWidth="Infinity"/>

    <Label text="Poids pion sur le plateau :"
           style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
    <TextField fx:id="pawnWeightField" onAction="#onPawnWeightChanged" maxWidth="Infinity"/>

    <Label text="Poids ligne de 4 pions :"
           style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
    <TextField fx:id="nearLineWeightField" onAction="#onNearLineWeightChanged" maxWidth="Infinity"/>

    <Separator/>

    <Label text="Évaluation de la position"
           style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #333333;"/>

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Noirs" style="-fx-font-style: italic; -fx-font-size: 11; -fx-text-fill: #888888;"/>
        <ProgressBar fx:id="evaluationBar"
                     progress="0.5"
                     maxWidth="Infinity"
                     HBox.hgrow="ALWAYS"
                     style="-fx-accent: black; -fx-control-inner-background: white;"/>
        <Label text="Blancs" style="-fx-font-style: italic; -fx-font-size: 11; -fx-text-fill: #888888;"/>
    </HBox>

    <Separator/>

    <Button text="Meilleur coup" onAction="#onBestMoveClicked" maxWidth="Infinity"
            style="-fx-font-weight: bold; -fx-background-color: #0066cc; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4;"/>

</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="but.info.sae2_12.ui.controllers.IAController">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Score victoire :" minWidth="180.0"/>
        <TextField fx:id="winScoreField" onAction="#onWinScoreChanged"/>
    </HBox>
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Poids anneau retiré :" minWidth="180.0"/>
        <TextField fx:id="ringRemovedWeightField" onAction="#onRingRemovedWeightChanged"/>
    </HBox>
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Poids pion sur le plateau :" minWidth="180.0"/>
        <TextField fx:id="pawnWeightField" onAction="#onPawnWeightChanged"/>
    </HBox>
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Poids ligne de 4 pions :" minWidth="180.0"/>
        <TextField fx:id="nearLineWeightField" onAction="#onNearLineWeightChanged"/>
    </HBox>
    <Label text="Évaluation de la position :"/>
    <ProgressBar fx:id="evaluationBar" progress="0.5" maxWidth="Infinity" style="-fx-accent: black; -fx-control-inner-background: white;"/>
</VBox>

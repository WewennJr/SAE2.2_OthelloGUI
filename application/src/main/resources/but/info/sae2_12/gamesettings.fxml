<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Text?>

<VBox spacing="10.0" prefWidth="190.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="but.info.sae2_12.ui.controllers.GameSettingsController"
      style="-fx-padding: 12; -fx-border-color: #cccccc; -fx-border-width: 1; -fx-background-color: #fafafa;"
      VBox.vgrow="ALWAYS" prefHeight="Infinity">
   <children>
      <Button fx:id="nouveau" mnemonicParsing="false" prefHeight="30.0" prefWidth="179.0" text="Nouvelle partie">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
      </Button>
      <Button fx:id="testNoir" mnemonicParsing="false" prefHeight="30.0" prefWidth="176.0" text="Test Noir">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </VBox.margin>
      </Button>
      <Button fx:id="testBlanc" mnemonicParsing="false" prefHeight="30.0" prefWidth="177.0" text="Test Blanc">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </VBox.margin>
      </Button>
      <Button fx:id="testState" mnemonicParsing="false" prefHeight="30.0" prefWidth="183.0" text="Test">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </VBox.margin>
      </Button>
      <CheckBox fx:id="edition" mnemonicParsing="false" prefHeight="25.0" prefWidth="178.0" text="Edition">
         <VBox.margin>
            <Insets bottom="5.0" left="10.0" right="10.0" />
         </VBox.margin>
      </CheckBox>
      <VBox fx:id="sousZone" prefHeight="118.0" prefWidth="128.0">
         <children>
            <RadioButton fx:id="radioNoir" mnemonicParsing="false" text="Noir">
               <toggleGroup>
                  <ToggleGroup fx:id="ChoixCouleur" />
               </toggleGroup>
               <VBox.margin>
                  <Insets left="15.0" />
               </VBox.margin>
            </RadioButton>
            <RadioButton fx:id="radioBlanc" mnemonicParsing="false" text="Blanc" toggleGroup="$ChoixCouleur">
               <VBox.margin>
                  <Insets left="15.0" />
               </VBox.margin>
            </RadioButton>
            <RadioButton fx:id="radioPion" mnemonicParsing="false" text="Pions">
               <toggleGroup>
                  <ToggleGroup fx:id="ChoixToken" />
               </toggleGroup>
               <VBox.margin>
                  <Insets left="15.0" />
               </VBox.margin>
            </RadioButton>
            <RadioButton fx:id="radioAnneau" mnemonicParsing="false" text="Anneaux" toggleGroup="$ChoixToken">
               <VBox.margin>
                  <Insets left="15.0" />
               </VBox.margin>
            </RadioButton>
         </children>
      </VBox>
      <ColorPicker fx:id="colorPicker1" >
         <VBox.margin>
            <Insets bottom="5.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
         <value>
            <Color red="0.501960813999176" green="0.501960813999176" blue="0.501960813999176" />
         </value>
      </ColorPicker>
      <ColorPicker fx:id="colorPicker2">
         <VBox.margin>
            <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
         <value>
            <Color red="0.38823530077934265" green="0.4000000059604645" blue="0.4156862795352936" opacity="0.8999999761581421" />
         </value>
      </ColorPicker>
      <ColorPicker fx:id="colorPicker3">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
         <value>
            <Color red="0.8274509906768799" green="0.8274509906768799" blue="0.8274509906768799" />
         </value>
      </ColorPicker>
      <CheckBox fx:id="coordonnees" mnemonicParsing="false" text="Coordonées" selected="true">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
      </CheckBox>
      <ListView fx:id="formatChoice" prefHeight="59.0" prefWidth="107.0">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </VBox.margin>
      </ListView>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Zoom">
         <VBox.margin>
            <Insets left="50.0" right="10.0" />
         </VBox.margin>
      </Text>
      <Slider fx:id="zoom" min="35.0">
         <VBox.margin>
            <Insets left="10.0" right="10.0" />
         </VBox.margin>
      </Slider>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Épaisseur">
         <VBox.margin>
            <Insets left="40.0" right="10.0" />
         </VBox.margin>
      </Text>
      <Slider fx:id="epaisseur" max="5.0" min="1.0" prefHeight="36.0" prefWidth="122.0">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </VBox.margin>
      </Slider>
   </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="CENTER_LEFT"
          style="-fx-padding: 6; -fx-border-color: #cccccc; -fx-border-width: 1;"
          xmlns="http://javafx.com/javafx/26"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="but.info.sae2_12.ui.controllers.GameStateController">

    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="80.0"/>
        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="80.0"/>
        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="80.0"/>
        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="80.0"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="10.0" valignment="CENTER" vgrow="NEVER"/>
    </rowConstraints>

    <HBox alignment="CENTER" spacing="6.0"
          style="-fx-padding: 0 12 0 0;"
          GridPane.columnIndex="0">
        <Label text="Joueur :"
               style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
        <Label fx:id="playerStatus" text="..."
               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0066cc;"/>
    </HBox>

    <HBox alignment="CENTER" spacing="6.0"
          style="-fx-padding: 0 12 0 12;"
          GridPane.columnIndex="1">
        <Label text="Phase :"
               style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
        <Label fx:id="phaseStatus" text="..."
               style="-fx-font-size: 12; -fx-text-fill: #333333;"/>
    </HBox>

    <HBox alignment="CENTER" spacing="6.0"
          style="-fx-padding: 0 12 0 12;"
          GridPane.columnIndex="2">
        <Label text="Anneaux :"
               style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
        <Label fx:id="nbAnneauxStatus" text="X"
               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #ff6600;"/>
    </HBox>

    <HBox alignment="CENTER" spacing="6.0"
          style="-fx-padding: 0 0 0 12;"
          GridPane.columnIndex="3">
        <Label text="Pions :"
               style="-fx-font-size: 11; -fx-text-fill: #888888; -fx-font-weight: bold;"/>
        <Label fx:id="nbPionsStatus" text="X"
               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #009900;"/>
    </HBox>

</GridPane>
